PROJECT_NAME="IP-SAKTI Sahayak Backend"
API_V1_PREFIX="/api/v1"
ENV="development"
DEBUG=True

# Database
DATABASE_URL=""

# Supabase PostgreSQL
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_DB_HOST="aws-0-REGION.pooler.supabase.com"
SUPABASE_DB_USER="postgres.YOUR_PROJECT_REF"
SUPABASE_DB_PASSWORD="YOUR_DATABASE_PASSWORD"
SUPABASE_DB_NAME="postgres"
SUPABASE_DB_PORT=5432

# LLM Configuration
LLM_PROVIDER="mock"  # mock | openai | bhashini | local
OPENAI_API_KEY="your-api-key-here"
OPENAI_MODEL="gpt-4o-mini"

# Retrieval & Vector DB
VECTOR_DB_TYPE="in-memory"  # in-memory | chroma | qdrant
CONFIDENCE_THRESHOLD_LOW=0.40
CONFIDENCE_THRESHOLD_HIGH=0.75

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Corpus Version
CORPUS_VERSION="1.0.0-202608"
